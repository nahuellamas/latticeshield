{
  "name": "@latticeshield/js",
  "version": "0.3.0",
  "description": "Browser SDK for LatticeShield PQC bridge — PQCSession + usePQCSession React hook",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "postbuild": "node scripts/sri.mjs",
